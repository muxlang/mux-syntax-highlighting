// Validation sample: keywords
auto x = 42
func add(int a, int b) returns int {
    return a + b
}

class User {
    string name

    func to_string() returns string {
        return name
    }
}

interface StringableThing {
    func to_string() returns string
}

enum Status {
    ready,
    failed(string)
}

// Control flow
if x > 40 {
    print("High")
} else {
    print("Low")
}

for int i in range(0, 10) {
    print(i)
}

while x > 0 {
    x -= 1
}

// Match with enum variants (some/ok/err are identifiers, not keywords)
match result {
    ok(value) { print(value) }
    err(msg) { print(msg) }
    none { print("none") }
}

// Generics
func unwrap<T>(result<T, string> res) returns T {
    match res {
        ok(val) { return val }
        err(e) { panic(e) }
    }
}

// References and operators
auto ref_x = &x
auto z = x ** 2 + 10 / 3
auto is_eq = x == 10
auto logical = true && false || !is_eq

// Literals
auto int_val = 1_000
auto float_val = 3.14e-2
auto char_val = 'a'
auto str_val = "hello"
auto keyword_str = "in common string"
auto multi_str = """
multi-line
string
"""
auto none_val = none
auto bool_val = true

// Leading-underscore identifiers highlight as names; a bare '_' does not
auto _unused = 1
auto _123 = 2
auto __ = 3

func discard(int _, string kept) returns string {
    return kept
}

class Factory {
    common func build() returns string {
        return "ready"
    }
}

func stringify(User user) returns string {
    return user.to_string()
}

// Slicing: the colon inside brackets is a delimiter, not a map separator.
// Either bound may be omitted, and a negative bound counts from the end.
auto numbers = [10, 20, 30, 40]
auto middle = numbers[1:3]
auto head = numbers[:2]
auto tail = numbers[2:]
auto whole = numbers[:]
auto last_two = numbers[-2:]

// A string slices and indexes like a list of characters
auto greeting = "hello"
auto part = greeting[1:3]
auto first = greeting[0]

// A declaration with no initializer: type and name, nothing else
string pending
int counter

// A module-qualified type in a type position, dotted like a path
func count_nodes(graph.Graph<string> g) returns int {
    return g.len()
}

// A trailing comma in a call argument list, and an expression across lines
auto total = sum(
    1,
    2,
    3,
)

// Comments
/* multi-line
comment */
// line comment
