{
  "name": "language-mux",
  "displayName": "Mux Language Support",
  "description": "Syntax highlighting and language support for the Mux programming language",
  "version": "0.13.0",
  "publisher": "muxlang",
  "license": "MIT",
  "icon": "./mux-icon.png",
  "main": "extension.bundle.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/muxlang/mux-syntax-highlighting.git",
    "directory": "textmate-mux/vscode-language-mux"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "activationEvents": [
    "onLanguage:mux"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mux",
        "aliases": [
          "Mux",
          "mux"
        ],
        "extensions": [
          ".mux"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mux",
        "scopeName": "source.mux",
        "path": "./source.mux.json"
      }
    ],
    "configuration": {
      "title": "Mux",
      "properties": {
        "mux.serverPath": {
          "type": "string",
          "default": "mux",
          "scope": "machine",
          "description": "Path to the Mux compiler executable. Restart VSCode after changing this setting."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
