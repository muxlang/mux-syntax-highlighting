{
  "name": "mux-syntax-highlighting",
  "version": "0.6.0",
  "private": true,
  "description": "Quality tooling for the Mux TextMate syntax definitions",
  "scripts": {
    "check": "npm run lint && npm run format:check && npm run samples && npm run test:vscode-client && node scripts/check-parity.js && node scripts/build-editor-support.js --check",
    "format": "prettier --write 'eslint.config.js' 'scripts/check-samples.js' 'scripts/package-vscode.js' 'scripts/verify-vsix.js' 'scripts/check-vscode-client.js' 'textmate-mux/vscode-language-mux/extension.js' 'textmate-mux/vscode-language-mux/package.json' 'package.json' '.prettierrc.json'",
    "format:check": "prettier --check 'eslint.config.js' 'scripts/check-samples.js' 'scripts/package-vscode.js' 'scripts/verify-vsix.js' 'scripts/check-vscode-client.js' 'textmate-mux/vscode-language-mux/extension.js' 'textmate-mux/vscode-language-mux/package.json' 'package.json' '.prettierrc.json'",
    "lint": "eslint . --max-warnings 0",
    "samples": "node scripts/check-samples.js",
    "package:vscode": "node scripts/package-vscode.js",
    "verify:vscode-package": "node scripts/verify-vsix.js",
    "test:vscode-client": "node scripts/check-vscode-client.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "prettier": "^3.6.2"
  }
}
